# ── Line endings (fix CRLF warnings on Windows) ─────────────
* text=auto
*.py  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env.example text eol=lf

# ── Binary files ─────────────────────────────────────────────
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
